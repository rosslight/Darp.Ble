<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.Ble\Darp.Ble.csproj" />
  </ItemGroup>
  <!-- The drivers need Windows; the registration and the platform-independent parts build everywhere -->
  <ItemGroup Condition="'$(TargetFramework)'!='net10.0-windows10.0.19041.0'">
    <Compile Remove="Windows\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darp.Ble.WinRT.Tests" />
    <InternalsVisibleTo Include="Darp.Ble.WinRT.Hardware.Tests" />
  </ItemGroup>
</Project>
